@{ ViewData["Title"] = "Lập bảng đối soát"; var partners = (List<Partner>)ViewBag.Partners; var pid = (int?)ViewBag.PartnerId; }
<div class="card" style="max-width:640px"><div class="card-body">
    <p class="text-muted small">Bảng đối soát đóng băng mọi phát sinh <b>chưa đối soát</b> của đối tác trong khoảng thời gian đã chọn, kèm dư đầu kỳ và dư cuối kỳ để gửi đối tác xác nhận.</p>
    <form asp-action="Create" method="post">@Html.AntiForgeryToken()
        <div class="mb-3"><label class="form-label small text-muted">Đối tác *</label>
            <select name="partnerId" class="form-select" required>
                <option value="">— Chọn đối tác —</option>
                @foreach (var p in partners) { <option value="@p.Id" selected="@(pid==p.Id)">@p.Code — @p.Name</option> }
            </select></div>
        <div class="row g-3">
            <div class="col-6"><label class="form-label small text-muted">Từ ngày</label><input name="fromDate" type="date" value="@DateTime.Today.AddMonths(-3).ToString("yyyy-MM-01")" class="form-control" required /></div>
            <div class="col-6"><label class="form-label small text-muted">Đến ngày</label><input name="toDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
        </div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-file-earmark-check me-1"></i>Lập & đóng băng</button> <a href="/Statement" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
