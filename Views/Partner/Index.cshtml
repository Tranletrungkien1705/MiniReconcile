@model List<PartnerBalance>
@{ ViewData["Title"] = "Đối tác & số dư"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <form method="get" class="mb-3 d-flex gap-2"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tên / mã đối tác..." style="max-width:240px" /><button class="btn btn-sm btn-primary">Tìm</button></form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Đối tác</th><th class="text-end">Số dư công nợ</th><th class="text-end">Quá hạn</th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr style="cursor:pointer" onclick="location.href='/Partner/Detail/@b.Partner.Id'">
                    <td class="fw-semibold">@b.Partner.Code</td><td>@b.Partner.Name<div class="small text-muted">@b.Partner.Phone</div></td>
                    <td class="text-end fw-semibold @(b.Balance > 0 ? "text-danger" : b.Balance < 0 ? "text-success" : "")">@Ui.Money(b.Balance)</td>
                    <td class="text-end">@if (b.Overdue > 0) { <span class="badge bg-danger">@Ui.Money(b.Overdue)</span> } else { <span class="text-muted">—</span> }</td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đối tác.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm đối tác</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên đối tác *" required /></div>
            <div class="mb-2"><input name="code" class="form-control" placeholder="Mã (tự sinh)" /></div>
            <div class="mb-2"><input name="phone" class="form-control" placeholder="SĐT" /></div>
            <div class="mb-2"><input name="email" type="email" class="form-control" placeholder="Email" /></div>
            <div class="mb-3"><label class="form-label small text-muted">Dư nợ đầu kỳ</label><input name="openingBalance" type="number" step="1000000" value="0" class="form-control" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
